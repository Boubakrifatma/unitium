{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pip-install-git-service",
      "type": "shell",
      "command": "pip",
      "args": ["install", "-r", "requirements.txt", "-q"],
      "options": {
        "cwd": "${workspaceFolder}/git-service"
      },
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "npm-install-frontend",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/Pi_ProjetFront"
      },
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "prepare-all",
      "dependsOn": ["pip-install-git-service", "npm-install-frontend"],
      "dependsOrder": "parallel"
    },
    {
      "label": "Start Git Service",
      "type": "shell",
      "command": "python",
      "args": ["main.py"],
      "options": {
        "cwd": "${workspaceFolder}/git-service"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Angular",
      "type": "shell",
      "command": "npm",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}/Pi_ProjetFront"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Start All (Tasks)",
      "dependsOn": ["Start Git Service", "Start Angular"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}